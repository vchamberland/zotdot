#!/usr/bin/env bash
# Public-repo guard: refuses a push whose new commits or resulting tree contain
# private network addresses, home-directory paths, private keys or API tokens.
# Generic patterns only (this file is public). Extra private patterns, one ERE
# per line, are read from $PUBLIC_GUARD_EXTRA (default: ~/.config/public-guard.patterns).
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
PAT='\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b'   # Tailscale CGNAT
PAT+='|\b(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}\b' # RFC1918
PAT+='|\.ts\.net\b|/home/[a-z_][a-z0-9_-]*/|/Users/[A-Za-z0-9_-]+/'
PAT+='|BEGIN [A-Z ]*PRIVATE KEY|ghp_[A-Za-z0-9]{20,}|github_pat_|gho_[A-Za-z0-9]{20,}'
PAT+='|xox[abpr]-|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,}'
EXTRA="${PUBLIC_GUARD_EXTRA:-$HOME/.config/public-guard.patterns}"
if [ -f "$EXTRA" ]; then while IFS= read -r p; do [ -n "$p" ] && [ "${p#\#}" = "$p" ] && PAT+="|$p"; done < "$EXTRA"; fi
zero=0000000000000000000000000000000000000000; fail=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                     # branch deletion
  range=$([ "$rsha" = "$zero" ] && echo "$lsha" || echo "$rsha..$lsha")
  hits=$( { git log --format='%B' "$range"; git log -p --format= "$range" -- . ':!.githooks/pre-push' | grep '^+' || true; git grep -I -h -e '' "$lsha" -- . ':!.githooks/pre-push' || true; } | grep -nE "$PAT" || true)
  if [ -n "$hits" ]; then fail=1; echo "public-guard: blocked push of $lsha, matches:" >&2; printf '%s\n' "$hits" | cut -c1-160 | head -20 >&2; fi
done
[ "$fail" -eq 0 ] || { echo "public-guard: remove the matches (or rewrite history) before pushing. Bypass only knowingly: git push --no-verify" >&2; exit 1; }
